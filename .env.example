# Copie a .env y complete valores reales (no suba .env al repositorio).

# --- Windows (desarrollo / escritorio) ---
# Ruta UNC al share. Si DNS falla, puede usar IP del file server:
# DATA_DIR=\\10.46.XX.XX\Administrativa\UO01\CISO01\CISO01_CIMDESS\S0022\data
DATA_DIR=\\SERVIDOR-NOMBRE.dominio.corp\Administrativa\UO01\CISO01\CISO01_CIMDESS\S0022\data

# --- Linux (Docker / producción) ---
# NO es URL ni hostname: es la ruta POSIX donde el SO YA montó el DFS.
# El montaje CIFS (fstab) es donde suele ir la IP en lugar del nombre DNS.
DATA_DIR_LINUX=/mnt/dfs/CISO01_CIMDESS/S0022/data

# Django
SECRET_KEY=cambiar-en-produccion
DEBUG=False
ALLOWED_HOSTS=*

# Oracle (ejemplo)
# ORACLE_CIM_HOST=10.46.2.43
# ...
